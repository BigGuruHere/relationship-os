{
  "name": "relationship-os",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "start:with-migrations": "prisma migrate deploy && node build/index.js",
    "migrate": "prisma migrate deploy",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "migrate:dev": "node scripts/safe-migrate-dev.js",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "tsx --test \"tests/core/*.test.ts\"",
    "test:core": "tsx --test \"tests/core/*.test.ts\"",
    "check:stage8.1": "tsx scripts/check-stage8-1-identity.ts",
    "check:stage8.2": "tsx scripts/check-stage8-2-provenance.ts",
    "check:stage8.3": "tsx scripts/check-stage8-3-consolidation.ts",
    "check:stage8.4": "tsx scripts/check-stage8-4-knowledge.ts",
    "check:stage8.4.3": "tsx scripts/check-stage8-4-3-knowledge-ux.ts",
    "check:stage8.5": "tsx scripts/check-stage8-5-agent-memory.ts",
    "check:stage8.5.2": "tsx scripts/check-stage8-5-2-isolation.ts",
    "check:stage8.6": "tsx scripts/check-stage8-6-context-space.ts",
    "check:stage8.6:mutation": "tsx scripts/mutate-stage8-6-context-trigger.ts",
    "check:stage8.7": "tsx scripts/check-stage8-7-cross-custody.ts"
  },
  "engines": {
    "node": ">=22.13.1 <23"
  },
  "engineStrict": false,
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@sveltejs/adapter-node": "^5.3.2",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prisma": "^6.16.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.0.4"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "argon2": "^0.44.0",
    "jose": "^6.1.0",
    "openai": "^6.2.0",
    "qrcode": "^1.5.4",
    "zod": "^4.1.5"
  }
}

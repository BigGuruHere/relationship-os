/// Relationship OS - Prisma schema
/// Vectors:
/// - We use pgvector columns for embeddings.
/// - InteractionEmbedding.vec and Tag.embedding_vec are type vector(1536).
/// - Prisma maps vectors using Unsupported("vector") and we write values via raw SQL with ::vector casts.
/// Tenant scoping:
/// - Every model that is user data includes userId and all queries must filter by userId on read and write.
/// Encryption:
/// - PII fields are AES-256-GCM encrypted server side only, with deterministic HMAC indexes for equality search.

// ---------------------------------------------------------------------------
// Datasource and generator
// ---------------------------------------------------------------------------
generator client {
  provider = "prisma-client-js" // Generate Prisma Client for Node and TS
}

datasource db {
  provider          = "postgresql" // Using Postgres
  url               = env("DATABASE_URL") // Connection string from your .env
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL") // optional - only used by migrate dev
}

// IT: role for feature gating
enum UserRole {
  owner
  member
  guest
}

// ---------------------------------------------------------------------------
// AUTH MODELS
// ---------------------------------------------------------------------------
// MODEL: User
// - Primary account for a single tenant
// - Email is stored encrypted at rest with a deterministic HMAC index for equality
model User {
  id           String   @id @default(uuid()) // pk stored as text uuid
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // IT: encrypted and indexed email - replaces legacy plaintext email
  email_Enc String? // ciphertext at rest
  email_Idx Bytes?  @unique // deterministic HMAC index for equality search

  // Owned data - tenant boundaries
  sessions      Session[]
  contacts      Contact[]
  interactions  Interaction[]
  tags          Tag[]
  companyTags   CompanyTag[]
  projectNotes  ProjectNote[]
  oauthAccounts OAuthAccount[] // external accounts linked to this user

  // IT: back-relation for one-shot reminders
  reminders Reminder[]

    // IT: ADD THIS LINE - back-relation for ContactRelationship
  contactRelationships ContactRelationship[]  // ← Add this

  subscription Subscription?

  // IT: deal records owned by this user
  deals Deal[]
  projectDeals ProjectDeal[]
  dealContacts DealContact[]
  dealNotes DealNote[]
  dealContactNotes DealContactNote[]

  // IT: relationship-linked action system. Tasks can sit on contacts, deals, deal-contact threads, or projects.
  projects Project[]
  tasks    Task[]

  // IT: company records and relationship graph for business broker use.
  companies             Company[]
  companyContacts       CompanyContact[]
  dealCompanies         DealCompany[]
  companyRelationships  CompanyRelationship[]
  exchangeItems         ExchangeItem[]

  // IT: agent framework records. Agents read/write through Relish services and every run is logged.
  agentDefinitions     AgentDefinition[]
  agentPromptVersions  AgentPromptVersion[]
  agentToolDefinitions AgentToolDefinition[]
  agentRuns            AgentRun[]
  agentToolCalls       AgentToolCall[]
  modelInvocations     ModelInvocation[]
  agentArtifacts       AgentArtifact[]
  approvalRequests     ApprovalRequest[]
  researchCandidates   ResearchCandidate[]
  researchSources      ResearchSource[]
  opportunityScores    OpportunityScore[]
  contactEnrichments   ContactEnrichment[]
  marketLeads          MarketLead[]
  marketLeadNotes      MarketLeadNote[]
  leadSources          LeadSource[]
  opportunityScoreFactors OpportunityScoreFactor[]

  role       UserRole @default(member)
  publicSlug String?  @unique

  // relations
  magicTokens  MagicToken[]
  inviteTokens InviteToken[] @relation("OwnerInvites")

  profiles Profile[]

  @@index([createdAt])
}

// IT: New table to track claimable leads
model Lead {
  id              String     @id @default(uuid())
  ownerId         String
  contactId       String
  // IT: store deterministic indexes to match later without decrypting
  emailIdx        String?    @db.VarChar(128)
  phoneIdx        String?    @db.VarChar(128)
  linkedinIdx     String?    @db.VarChar(128)

  linkedinEnc     String?

  // IT: claim status
  status          LeadStatus @default(PENDING)
  claimedByUserId String?
  inviteToken     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([ownerId])
  @@index([emailIdx])
  @@index([phoneIdx])
  @@index([linkedinIdx])
  @@unique([ownerId, linkedinIdx])
}

enum LeadStatus {
  PENDING
  CLAIMED
}

// IT: single use sign in tokens for magic link login
model MagicToken {
  id        String    @id @default(uuid())
  userId    String
  // IT: store only an HMAC of the token - never the raw token
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// IT: short lived token that binds a public profile page to the owner
model InviteToken {
  id        String    @id @default(uuid())
  ownerId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  owner User @relation("OwnerInvites", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// PURPOSE: link external OAuth providers like Google to a local User
model OAuthAccount {
  id String @id @default(uuid()) // pk

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String // e.g. "google"
  providerAccountId String // stable provider user id - for Google this is the "sub" claim
  // IT: removed plaintext email - provider email is handled via User.email_Enc and User.email_Idx
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId]) // prevent duplicate links
  @@index([userId])
}

// MODEL: Session
// - Stores session token hash and expiry
// - tokenHash is a server side HMAC of a random token sent to the browser
model Session {
  id     String @id @default(uuid()) // pk
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique // HMAC of random token
  createdAt DateTime @default(now())
  expiresAt DateTime // absolute expiry

  @@index([userId])
}

// IT: Stripe subscription record scoped to a single user
// - One Subscription per User (userId is unique)
// - Stores only Stripe ids and status, no card details
model Subscription {
  id String @id @default(uuid()) // pk

  // Tenant ownership - this links to User as the single owner
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stripe identifiers - used by webhook handlers
  stripeCustomerId     String  @unique  // Stripe customer id, e.g. "cus_..."
  stripeSubscriptionId String  @unique  // Stripe subscription id, e.g. "sub_..."
  priceId              String           // Stripe price id used, e.g. "price_..."

  // Subscription lifecycle
  status             SubscriptionStatus @default(trialing)
  currentPeriodEnd   DateTime           // end of current billing period
  cancelAtPeriodEnd  Boolean            @default(false) // soft cancel flag

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}


// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------
enum CreatedBy {
  ai
  user
}

enum AssignedBy {
  ai
  user
}

// IT: subscription lifecycle states mirrored from Stripe
enum SubscriptionStatus {
  trialing   // in trial period
  active     // paid and current
  past_due   // payment issue, grace period
  canceled   // ended by user or system
  incomplete // created but not completed
}


// IT: Tag - pgvector tracked by Prisma without a native type
model Tag {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  slug      String
  createdBy CreatedBy
  createdAt DateTime  @default(now())

  // IT: pgvector column - Prisma tracks but does not parse
  embeddingVec Unsupported("vector")? @map("embedding_vec")

  mergedIntoId String?
  mergedInto   Tag?    @relation(name: "TagMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Tag[]   @relation(name: "TagMerge")

  aliases  TagAlias[]
  contacts ContactTag[]
  companies CompanyTag[]

  @@unique([userId, name])
  @@unique([userId, slug])
  @@index([userId, createdBy, createdAt])
  @@map("Tag")
}

// ---------------------------------------------------------------------------
// MODEL: TagAlias
// ---------------------------------------------------------------------------
model TagAlias {
  id String @id @default(uuid())

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  alias String
  slug  String

  @@unique([tagId, slug])
}

// ---------------------------------------------------------------------------
// MODEL: Contact
// Encrypted PII plus deterministic HMAC index columns - tenant scoped
// ---------------------------------------------------------------------------
model Contact {
  id String @id @default(uuid()) // pk

  // Tenant ownership
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Encrypted at rest fields
  fullNameEnc String
  emailEnc    String?
  phoneEnc    String?
  companyEnc  String?

  // Deterministic indexable tokens
  fullNameIdx String
  emailIdx    String?
  phoneIdx    String?
  companyIdx  String?

  positionEnc String?
  positionIdx String?

  linkedinEnc String?
  linkedinIdx String?

  // IT: usual/best channel for relationship follow-up. Stored as an enum, not encrypted, because it is workflow metadata.
  usualCommunicationMethod CommunicationMethod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reconnectEveryDays Int?
  lastContactedAt    DateTime?

  // Relations
  interactions Interaction[]
  tags         ContactTag[]
  linkedUserId String?

  sourceProfileId String?          // profile used when this contact was first created

  relationshipsAsA ContactRelationship[] @relation("ContactAsA")
  relationshipsAsB ContactRelationship[] @relation("ContactAsB")

  reminders Reminder[]

  // IT: links between this contact and relationship-driven deals
  dealLinks DealContact[]

  // IT: optional deal notes that were recorded against this contact in a deal context
  dealNotes DealNote[]

  // IT: notes/tasks where this contact is the commercial party or external person being waited on.
  dealContactNotes DealContactNote[] @relation("DealContactNoteContact")
  tasks             Task[]            @relation("TaskContact")
  assignedTasks     Task[]            @relation("TaskAssignedContact")
  waitingTasks      Task[]            @relation("TaskWaitingContact")

  // IT: company memberships/employment history. A person can belong to more than one company over time.
  companyLinks      CompanyContact[]
  exchangeItems     ExchangeItem[]
  opportunityScores OpportunityScore[]
  opportunityScoreFactors OpportunityScoreFactor[]
  researchSources   ResearchSource[]
  contactEnrichments ContactEnrichment[]
  marketLeads        MarketLead[]

  // Indexes for search and tenancy
  @@index([userId])
  @@index([fullNameIdx])
  @@index([emailIdx])
  @@index([phoneIdx])
  @@index([companyIdx])
  @@index([userId, usualCommunicationMethod])

    // IT: new - one contact per owner-user pair; multiple NULLs are allowed by Postgres
  @@unique([userId, linkedUserId])
}

// ---------------------------------------------------------------------------
// MODEL: Interaction
// ---------------------------------------------------------------------------
model Interaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())
  channel    String
  rawTextEnc String
  summaryEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  InteractionEmbedding InteractionEmbedding?

  @@index([userId])
  @@index([contactId])
  @@index([occurredAt])
}

// IT: InteractionEmbedding - pgvector tracked the same way
model InteractionEmbedding {
  interactionId String      @id
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  vec Unsupported("vector")? @map("vec")

  @@map("InteractionEmbedding")
}

// ---------------------------------------------------------------------------
// MODEL: ContactTag
// ---------------------------------------------------------------------------
model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedBy AssignedBy
  assignedAt DateTime   @default(now())

  @@id([contactId, tagId])
  @@index([tagId])
}

// IT: tags can also be attached to companies so sector/search labels work beyond people.
model CompanyTag {
  id String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedBy AssignedBy @default(user)
  assignedAt DateTime   @default(now())

  @@unique([companyId, tagId])
  @@index([userId])
  @@index([companyId])
  @@index([tagId])
}

// IT: one-shot reminders with optional auto-roll if you want later
model Reminder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  dueAt DateTime
  note  String?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, dueAt])
  @@index([userId, contactId, dueAt])
}

// IT: types of profiles - extend later if needed
enum ProfileKind {
  business
  personal
  dating
  custom
}

// IT: public shareable profile owned by a user
model Profile {
  id        String      @id @default(uuid())
  userId    String
  kind      ProfileKind @default(business)
  label     String      @default("My profile")
  slug      String      @unique
  isDefault Boolean     @default(false)

  // Public fields only
  displayName String?
  headline    String?
  bio         String?
  avatarUrl   String?
  company     String?
  title       String?
  websiteUrl  String?
  emailPublic String?
  phonePublic String?
  socials     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  qrReady       Boolean   @default(false)
  qrSvg         String?
  qrGeneratedAt DateTime?

  publicMeta Json?

  @@index([userId, isDefault])
}

// IT: flexible many-to-many relationships between contacts
model ContactRelationship {
  id        String   @id @default(uuid())
  userId    String   // tenant scope
  
  contactAId String
  contactBId String
  
  // IT: make relationship type OPTIONAL - can be null initially
  relationshipType RelationshipType?  // ← Note the ? makes it nullable
  
  // IT: free-text label - use this for simple "knows" or custom descriptions
  label     String?  @default("knows") // simple fallback
  
  // IT: optional metadata for future richness
  metadata  Json?
  
  // IT: directional flag
  isDirectional Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  contactA  Contact @relation("ContactAsA", fields: [contactAId], references: [id], onDelete: Cascade)
  contactB  Contact @relation("ContactAsB", fields: [contactBId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // IT: allow multiple relationships between same contacts with different types
  @@unique([userId, contactAId, contactBId, relationshipType, label])
  @@index([userId, contactAId])
  @@index([userId, contactBId])
  @@index([userId, relationshipType])
}

// IT: keep enum in DB for future use, but make it optional in model
enum RelationshipType {
  // Professional
  WORKS_WITH
  REPORTS_TO
  MANAGES
  COLLEAGUE
  CLIENT
  VENDOR
  PARTNER
  
  // Personal
  SPOUSE
  FAMILY
  FRIEND
  ACQUAINTANCE
  
  // Social
  INTRODUCED_BY
  MET_THROUGH
  
  // Meta
  CUSTOM
}


// ---------------------------------------------------------------------------
// DEAL MODELS
// ---------------------------------------------------------------------------
// IT: state of a deal pipeline. Keep as enum so filtering stays reliable.
enum DealStatus {
  DISCOVERY
  QUALIFYING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

// IT: role a contact plays in a deal. Similar idea to ContactRelationship.
enum DealRelationshipType {
  DECISION_MAKER
  CHAMPION
  INFLUENCER
  REFERRER
  ADVISOR
  BROKER
  PARTNER
  BUYER
  POTENTIAL_BUYER
  SELLER
  INVESTOR
  SUPPLIER
  CUSTOM
}

// IT: relationship-driven opportunity or deal owned by a user.
model Deal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // IT: encrypted title and optional notes. titleIdx supports exact lookup.
  titleEnc              String
  titleIdx              String
  descriptionEnc        String?
  descriptionSummaryEnc String?

  // IT: commercial fields. Store value in minor units to avoid float rounding.
  valueCents        Int?
  currency          String     @default("AUD")
  status            DealStatus @default(DISCOVERY)
  probability       Int?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReasonEnc     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts DealContact[]
  companies DealCompany[]
  notes    DealNote[]
  dealContactNotes DealContactNote[]
  tasks    Task[]
  projects ProjectDeal[]
  exchangeItems ExchangeItem[]
  opportunityScores OpportunityScore[]
  opportunityScoreFactors OpportunityScoreFactor[]
  marketLeads        MarketLead[]

  @@index([userId, status])
  @@index([userId, expectedCloseDate])
  @@index([userId, createdAt])
  @@index([titleIdx])
}

// IT: notes and voice notes attached directly to a deal.
// IT: contactId is optional so a deal note can either be general, or tied to one person involved in the deal.
model DealNote {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  channel    String    @default("note")
  rawTextEnc String
  summaryEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dealId, occurredAt])
  @@index([userId, contactId, occurredAt])
}

// IT: relationship stage for one person inside one deal.
enum DealContactStage {
  NOT_CONTACTED
  CONTACTED
  TEASER_SENT
  NDA_SENT
  NDA_SIGNED
  IM_SENT
  MEETING_BOOKED
  REVIEWING
  OFFER_EXPECTED
  OFFER_MADE
  DECLINED
  NOT_SUITABLE
  DORMANT
}

// IT: simple commercial temperature for a person in a specific deal.
enum DealContactInterest {
  UNKNOWN
  COLD
  WARM
  HOT
  STRONG_FIT
  NOT_A_FIT
}

// IT: confidentiality stage for what this person has received or signed.
enum DealConfidentialityStage {
  NONE
  BLIND_TEASER_SENT
  NDA_SENT
  NDA_SIGNED
  IM_SENT
  DATA_ROOM_ACCESS
  VENDOR_APPROVED
}

// IT: many-to-many contact involvement in a deal with a relationship role.
model DealContact {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  relationshipType DealRelationshipType?
  label            String? @default("connected")
  notesEnc         String?
  isPrimary        Boolean @default(false)

  // IT: business-broker specific state for this person inside this deal.
  stage                DealContactStage          @default(NOT_CONTACTED)
  interestLevel        DealContactInterest       @default(UNKNOWN)
  confidentialityStage DealConfidentialityStage  @default(NONE)
  nextActionEnc        String?
  nextFollowUpAt       DateTime?
  lastContactedAt      DateTime?
  buyingCriteriaEnc    String?
  objectionsEnc        String?
  fundingCapacityEnc   String?
  referralPathEnc      String?

  notes DealContactNote[]
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, contactId, label])
  @@index([userId, dealId])
  @@index([userId, contactId])
  @@index([userId, relationshipType])
  @@index([userId, stage])
  @@index([userId, interestLevel])
  @@index([userId, nextFollowUpAt])
}


// IT: notes and voice notes for the commercial conversation between one contact and one deal.
model DealContactNote {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dealContactId String
  dealContact   DealContact @relation(fields: [dealContactId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation("DealContactNoteContact", fields: [contactId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  channel    String    @default("note")
  rawTextEnc String
  summaryEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dealContactId, occurredAt])
  @@index([userId, dealId, occurredAt])
  @@index([userId, contactId, occurredAt])
}


// ---------------------------------------------------------------------------
// COMPANY MODELS
// ---------------------------------------------------------------------------
// IT: broad company categories used for brokers, acquirers, advisors, funders, and vendors.
enum CompanyKind {
  OPERATING_BUSINESS
  STRATEGIC_ACQUIRER
  FINANCIAL_BUYER
  INVESTOR
  BROKERAGE
  ADVISORY_FIRM
  LAW_FIRM
  ACCOUNTING_FIRM
  FUNDER
  VENDOR_BUSINESS
  OTHER
}

enum CompanyStatus {
  ACTIVE
  WATCHLIST
  DO_NOT_CONTACT
  ARCHIVED
}

enum CompanyContactStatus {
  CURRENT
  FORMER
  ADVISOR
  UNKNOWN
}

enum CompanyRelationshipType {
  PARENT_COMPANY
  SUBSIDIARY
  DIVISION
  SISTER_COMPANY
  INVESTOR_IN
  OWNED_BY
  STRATEGIC_PARTNER
  REFERRAL_PARTNER
  SUPPLIER
  CUSTOMER
  COMPETITOR
  ADVISOR_TO
  BROKER_FOR
  RELATED_ENTITY
  CUSTOM
}

// IT: first-class organisation record. This lets you track likely acquirers before you know a person inside them.
model Company {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nameEnc        String
  nameIdx        String
  websiteEnc     String?
  websiteIdx     String?
  phoneEnc       String?
  phoneIdx       String?
  industryEnc    String?
  locationEnc    String?
  descriptionEnc String?
  criteriaEnc    String?
  notesEnc       String?

  kind   CompanyKind   @default(OPERATING_BUSINESS)
  status CompanyStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts         CompanyContact[]
  tags             CompanyTag[]
  dealLinks        DealCompany[]
  tasks            Task[]
  relationshipsAsA CompanyRelationship[] @relation("CompanyAsA")
  relationshipsAsB CompanyRelationship[] @relation("CompanyAsB")
  exchangeItems     ExchangeItem[]
  opportunityScores OpportunityScore[]
  opportunityScoreFactors OpportunityScoreFactor[]
  researchSources   ResearchSource[]
  contactEnrichments ContactEnrichment[]
  marketLeads        MarketLead[]

  @@index([userId, nameIdx])
  @@index([userId, kind])
  @@index([userId, status])
  @@index([nameIdx])
  @@index([websiteIdx])
  @@index([phoneIdx])
}

// IT: links people to companies. This is employment/membership history rather than a single company field on Contact.
model CompanyContact {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  titleEnc      String?
  departmentEnc String?
  notesEnc      String?
  status        CompanyContactStatus @default(CURRENT)
  isPrimary     Boolean @default(false)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, contactId])
  @@index([userId, companyId])
  @@index([userId, contactId])
  @@index([userId, status])
}

// IT: a company inside a deal. Useful for potential acquirers where you do not yet have a human contact.
model DealCompany {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  relationshipType DealRelationshipType?
  label            String? @default("connected")
  notesEnc         String?
  isPrimary        Boolean @default(false)

  stage                DealContactStage         @default(NOT_CONTACTED)
  interestLevel        DealContactInterest      @default(UNKNOWN)
  confidentialityStage DealConfidentialityStage @default(NONE)
  nextActionEnc        String?
  nextFollowUpAt       DateTime?
  lastContactedAt      DateTime?
  acquisitionRationaleEnc String?
  objectionsEnc        String?
  fundingCapacityEnc   String?
  referralPathEnc      String?

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, companyId, label])
  @@index([userId, dealId])
  @@index([userId, companyId])
  @@index([userId, relationshipType])
  @@index([userId, stage])
  @@index([userId, interestLevel])
  @@index([userId, nextFollowUpAt])
}

// IT: company graph for parents/subsidiaries, investors, referral partners, and related entities.
model CompanyRelationship {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyAId String
  companyBId String

  relationshipType CompanyRelationshipType?
  label            String? @default("related")
  notesEnc         String?
  isDirectional    Boolean @default(true)

  companyA Company @relation("CompanyAsA", fields: [companyAId], references: [id], onDelete: Cascade)
  companyB Company @relation("CompanyAsB", fields: [companyBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyAId, companyBId, relationshipType, label])
  @@index([userId, companyAId])
  @@index([userId, companyBId])
  @@index([userId, relationshipType])
}


// ---------------------------------------------------------------------------
// WANTS AND OFFERS MODELS
// ---------------------------------------------------------------------------
// IT: Whether the exchange item represents a need/want or something available to offer.
enum ExchangeItemType {
  WANT
  OFFER
}

// IT: How soon this want/offer matters.
enum ExchangeUrgency {
  LOW
  NORMAL
  HIGH
  IMMEDIATE
}

// IT: When the want/offer is relevant.
enum ExchangeTimeHorizon {
  NOW
  NEXT_30_DAYS
  NEXT_90_DAYS
  THIS_YEAR
  LATER
  ONGOING
}

// IT: Lifecycle state to keep stale wants/offers out of future matching.
enum ExchangeStatus {
  ACTIVE
  PAUSED
  FULFILLED
  EXPIRED
  ARCHIVED
}

// IT: Confidence in whether this want/offer was explicitly stated or inferred.
enum ExchangeConfidence {
  LOW
  MEDIUM
  HIGH
}

// IT: Direction gives more nuance than type alone while still keeping wants/offers simple.
enum ExchangeDirection {
  SEEKING
  OFFERING
  OPEN_TO
  NOT_INTERESTED_IN
  OTHER
}

// IT: A relationship value item attached to a person, company, deal, or project.
// IT: Embedding is stored for future matching, but no matching/search algorithm is required yet.
model ExchangeItem {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      ExchangeItemType
  direction ExchangeDirection @default(OTHER)
  categoryEnc String?

  titleEnc       String
  descriptionEnc String?
  summaryEnc     String?

  importance Int @default(3)
  urgency    ExchangeUrgency    @default(NORMAL)
  timeHorizon ExchangeTimeHorizon @default(ONGOING)
  status     ExchangeStatus     @default(ACTIVE)
  confidence ExchangeConfidence @default(MEDIUM)

  geographyEnc String?
  valueMinCents Int?
  valueMaxCents Int?
  currency      String @default("AUD")
  reviewAt      DateTime?
  expiresAt     DateTime?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  embeddingVec Unsupported("vector")? @map("embedding_vec")

  marketLeads MarketLead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@index([userId, status])
  @@index([userId, urgency])
  @@index([userId, timeHorizon])
  @@index([userId, confidence])
  @@index([userId, reviewAt])
  @@index([userId, expiresAt])
  @@index([userId, contactId])
  @@index([userId, companyId])
  @@index([userId, dealId])
  @@index([userId, projectId])
}


// ---------------------------------------------------------------------------
// STAGE 6 MARKET LEADS
// ---------------------------------------------------------------------------
// IT: Channel preference for contacts and leads. This is workflow metadata used
// to choose the right relationship action.
enum CommunicationMethod {
  LINKEDIN
  EMAIL
  PHONE
  SMS
  WHATSAPP
  IN_PERSON
  OTHER
  UNKNOWN
}

// IT: Broad lead types for market-making. These are deliberately broader than
// Contact/Company/Deal so you can capture uncertain items before they are researched.
enum MarketLeadType {
  BUYER
  SELLER
  COMPANY
  CONTACT
  MANDATE
  ASSET
  REFERRER
  OTHER
  POTENTIAL_BUYER
  POTENTIAL_SELLER
}

// IT: Review lifecycle for market leads.
enum MarketLeadStatus {
  NEW
  RESEARCHING
  QUALIFIED
  CONVERTED
  NOT_RELEVANT
  ARCHIVED
  NOT_CONTACTED
  TRIED_NO_CONTACT
  LEFT_VOICEMAIL
  FOLLOW_UP_NEEDED
  CONTACTED
  RESPONDED
  NURTURE
}

// IT: Where this lead came from. Keep it high-level for filtering.
enum MarketLeadSource {
  MANUAL
  OUTREACH
  REFERRAL
  INBOUND
  RESEARCH
  IMPORTED
  AI
  OTHER
}


// IT: Custom user-owned lead sources. This lets you reuse sources like Sam,
// Sam spreadsheet, MFAA list, LinkedIn, or referral partner names in dropdowns.
model LeadSource {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nameEnc String
  nameIdx String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketLeads MarketLead[]

  @@unique([userId, nameIdx])
  @@index([userId, updatedAt])
  @@index([nameIdx])
}

// IT: A market-making lead: an unconfirmed person, company, mandate, asset,
// referrer, buyer, or seller signal that may later become CRM truth.
model MarketLead {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   MarketLeadType   @default(OTHER)
  status MarketLeadStatus @default(NEW)
  source MarketLeadSource @default(MANUAL)

  leadSourceId String?
  leadSource   LeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)

  titleEnc       String
  titleIdx       String
  nameEnc        String?
  nameIdx        String?
  companyNameEnc String?
  companyNameIdx String?
  emailEnc       String?
  emailIdx       String?
  phoneEnc       String?
  phoneIdx       String?
  websiteEnc     String?
  websiteIdx     String?
  linkedinEnc    String?
  linkedinIdx    String?
  roleTitleEnc   String?
  geographyEnc   String?
  addressEnc     String?
  addressIdx     String?
  descriptionEnc String?
  notesEnc       String?
  sourceUrlEnc   String?

  usualCommunicationMethod CommunicationMethod?

  confidence Int @default(50)
  priority   Int @default(3)
  valueMinCents Int?
  valueMaxCents Int?
  currency      String @default("AUD")
  nextActionEnc String?
  nextActionAt  DateTime?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  tasks Task[]
  notes MarketLeadNote[]

  exchangeItemId String?
  exchangeItem   ExchangeItem? @relation(fields: [exchangeItemId], references: [id], onDelete: SetNull)

  convertedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, type])
  @@index([userId, status])
  @@index([userId, source])
  @@index([userId, leadSourceId])
  @@index([userId, priority])
  @@index([userId, confidence])
  @@index([userId, usualCommunicationMethod])
  @@index([userId, contactId])
  @@index([userId, companyId])
  @@index([userId, dealId])
  @@index([userId, projectId])
  @@index([userId, exchangeItemId])
  @@index([titleIdx])
  @@index([nameIdx])
  @@index([companyNameIdx])
  @@index([emailIdx])
  @@index([phoneIdx])
  @@index([websiteIdx])
  @@index([linkedinIdx])
  @@index([addressIdx])
}

// IT: time-stamped notes attached directly to a market lead. These preserve early, messy
// research and conversation context before the lead is converted into stronger CRM records.
model MarketLeadNote {
  id String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketLeadId String
  marketLead   MarketLead @relation(fields: [marketLeadId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())
  channel    String   @default("note")
  bodyEnc    String
  summaryEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, marketLeadId, occurredAt])
  @@index([userId, marketLeadId, createdAt])
}

// ---------------------------------------------------------------------------
// PROJECT AND TASK MODELS
// ---------------------------------------------------------------------------
enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  SNOOZED
  DONE
  CANCELLED
}

enum TaskUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TaskImportance {
  LOW
  NORMAL
  HIGH
}

enum TaskFocus {
  NEW
  DOING_NOW
  NOT_DOING_NOW
  NEVER_DOING_NOW
}

enum TaskType {
  FOLLOW_UP
  CALL
  EMAIL
  SEND_DOCUMENT
  BOOK_MEETING
  RESEARCH
  PREPARE
  REVIEW
  INTRODUCE
  DECISION
  ADMIN
  PERSONAL_TODO
  DEAL_STEP
  CUSTOM
}

// IT: a broader work container that can hold tasks and be linked manually by name/context.
model Project {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titleEnc       String
  titleIdx       String
  descriptionEnc String?
  status         ProjectStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
  notes ProjectNote[]
  deals ProjectDeal[]
  exchangeItems ExchangeItem[]
  marketLeads   MarketLead[]

  @@index([userId, status])
  @@index([titleIdx])
}

// IT: Direct many-to-many link between projects and deals.
// IT: A task can still relate to both, but this table says the deal belongs to the project.
model ProjectDeal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  labelEnc String?
  notesEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, dealId])
  @@index([userId, projectId])
  @@index([userId, dealId])
  @@index([userId, createdAt])
}

// IT: time-stamped notes attached directly to a project. These are separate from the project description.
model ProjectNote {
  id String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())
  channel    String   @default("note")
  bodyEnc    String
  summaryEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, projectId, createdAt])
}

// IT: unified action system. A task can link to a person, deal, deal-contact thread, or project.
model Task {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titleEnc   String
  notesEnc   String?
  summaryEnc String?

  status     TaskStatus     @default(OPEN)
  urgency    TaskUrgency    @default(NORMAL)
  importance TaskImportance @default(NORMAL)
  focus      TaskFocus      @default(NEW)
  taskType   TaskType       @default(FOLLOW_UP)

  dueAt        DateTime?
  snoozedUntil DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  // IT: assignment is intentionally flexible while the app is still single-user.
  assignedToTextEnc  String?
  assignedToContactId String?
  assignedToContact   Contact? @relation("TaskAssignedContact", fields: [assignedToContactId], references: [id], onDelete: SetNull)

  waitingOnContactId String?
  waitingOnContact   Contact? @relation("TaskWaitingContact", fields: [waitingOnContactId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation("TaskContact", fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  dealContactId String?
  dealContact   DealContact? @relation(fields: [dealContactId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  marketLeadId String?
  marketLead   MarketLead? @relation(fields: [marketLeadId], references: [id], onDelete: SetNull)

  // IT: optional company context for broker work.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  dealCompanyId String?
  dealCompany   DealCompany? @relation(fields: [dealCompanyId], references: [id], onDelete: SetNull)

  sourceType String?
  sourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, dueAt])
  @@index([userId, focus, dueAt])
  @@index([userId, urgency])
  @@index([userId, contactId])
  @@index([userId, dealId])
  @@index([userId, dealContactId])
  @@index([userId, projectId])
  @@index([userId, marketLeadId])
  @@index([userId, companyId])
  @@index([userId, dealCompanyId])
  @@index([userId, waitingOnContactId])
}


// ---------------------------------------------------------------------------
// AGENT STAGE 2 OUTREACH MODELS
// ---------------------------------------------------------------------------
// IT: Candidate type staged by the Outreach Agent before importing into CRM.
enum ResearchCandidateEntityType {
  COMPANY
  CONTACT
}

// IT: Review/import lifecycle for AI-found or manually pasted research candidates.
enum ResearchCandidateStatus {
  CANDIDATE
  APPROVED
  REJECTED
  IMPORTED
}


// IT: Stage 3 source types captured by controlled live research tools.
enum ResearchSourceType {
  SEARCH_RESULT
  WEB_PAGE
  USER_SOURCE
  EXTRACTED_PROFILE
  OTHER
}

// IT: Temporary staging area. AI can propose candidates here without polluting real CRM data.
model ResearchCandidate {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId String?
  run        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  entityType ResearchCandidateEntityType @default(COMPANY)
  status     ResearchCandidateStatus     @default(CANDIDATE)

  nameEnc       String
  nameIdx       String
  websiteEnc    String?
  websiteIdx    String?
  sourceUrlEnc  String?
  sourceLabelEnc String?
  confidence    Int @default(50)

  structuredJson Json?
  notesEnc       String?

  createdEntityType String?
  createdEntityId   String?

  opportunityScores OpportunityScore[]
  opportunityScoreFactors OpportunityScoreFactor[]
  researchSources    ResearchSource[]
  contactEnrichments ContactEnrichment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, entityType])
  @@index([userId, nameIdx])
  @@index([agentRunId])
}


// IT: Durable evidence/source log for live research.
// IT: Agents can read web/search output, but Relish stores the source and only stages proposed CRM changes.
model ResearchSource {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId String?
  run        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  researchCandidateId String?
  researchCandidate   ResearchCandidate? @relation(fields: [researchCandidateId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  sourceType ResearchSourceType @default(SEARCH_RESULT)
  provider   String @default("manual")
  confidence Int    @default(50)

  queryEnc   String?
  titleEnc   String?
  urlEnc     String?
  snippetEnc String?
  contentEnc String?

  evidenceJson Json?
  fetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sourceType])
  @@index([userId, provider])
  @@index([userId, companyId])
  @@index([userId, contactId])
  @@index([userId, researchCandidateId])
  @@index([agentRunId])
}


// IT: Stage 5 Contact Enrichment staging. Proposed contact details are not CRM truth until reviewed/applied.
model ContactEnrichment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId String?
  run        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  researchCandidateId String?
  researchCandidate   ResearchCandidate? @relation(fields: [researchCandidateId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  status     String @default("CANDIDATE")
  confidence Int    @default(50)

  // IT: Stage 5.1 stores enrichment at field level so email, phone, LinkedIn, role, and company data can be reviewed independently.
  groupKey       String?
  fieldKey       String?
  fieldLabel     String?
  proposedValueEnc String?
  existingValueEnc String?
  evidenceType   String @default("UNKNOWN")
  sourceKind     String?
  conflictStatus String @default("NEW")
  isApplyable    Boolean @default(true)

  targetNameEnc String?
  fullNameEnc   String?
  emailEnc      String?
  phoneEnc      String?
  linkedinEnc   String?
  companyNameEnc String?
  roleTitleEnc    String?
  websiteEnc      String?

  sourceUrlEnc   String?
  sourceLabelEnc String?
  evidenceEnc    String?
  notesEnc       String?
  structuredJson Json?

  appliedAt DateTime?
  appliedEntityType String?
  appliedEntityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, contactId])
  @@index([userId, companyId])
  @@index([userId, researchCandidateId])
  @@index([agentRunId])
  @@index([userId, fieldKey])
  @@index([agentRunId, groupKey])
  @@index([userId, conflictStatus])
}

// IT: Structured opportunity scoring for a staged candidate or existing CRM record.
model OpportunityScore {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId String?
  run        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  researchCandidateId String?
  researchCandidate   ResearchCandidate? @relation(fields: [researchCandidateId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // IT: Stage 4 scorecards are still advisory. They rank attention, not truth.
  scoreVersion        Int    @default(2)
  scoreLabel          String @default("watch")
  priority            String @default("medium")
  recommendedAction   String?

  totalScore          Int @default(0)
  sectorFitScore      Int?
  ownerLedScore       Int?
  dealLikelihoodScore Int?
  outreachFitScore    Int?
  timingScore         Int?
  confidenceScore     Int?

  strategicFitScore      Int?
  valuePotentialScore    Int?
  relationshipPathScore  Int?
  evidenceQualityScore   Int?
  riskScore              Int?

  rationaleJson       Json?
  factors             OpportunityScoreFactor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, totalScore])
  @@index([userId, scoreLabel])
  @@index([userId, priority])
  @@index([userId, companyId])
  @@index([userId, contactId])
  @@index([userId, dealId])
  @@index([userId, researchCandidateId])
  @@index([agentRunId])
}

// IT: Stage 4 score-factor table. Each score is explainable and reviewable.
model OpportunityScoreFactor {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  opportunityScoreId String
  opportunityScore   OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)

  researchCandidateId String?
  researchCandidate   ResearchCandidate? @relation(fields: [researchCandidateId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  criterionKey   String
  criterionLabel String
  score          Int @default(0)
  weight         Int @default(1)
  polarity       String @default("positive")
  confidence     Int @default(50)

  evidenceEnc    String?
  rationaleEnc   String?
  sourceUrlEnc   String?
  metadataJson   Json?

  createdAt DateTime @default(now())

  @@index([userId, criterionKey])
  @@index([userId, opportunityScoreId])
  @@index([userId, researchCandidateId])
  @@index([userId, companyId])
  @@index([userId, contactId])
  @@index([userId, dealId])
}

// ---------------------------------------------------------------------------
// AGENT FRAMEWORK MODELS
// ---------------------------------------------------------------------------
// IT: AgentDefinition is the durable configuration for a specialised agent.
// IT: Relish remains the source of truth - agents act through registered tools and logged runs.
model AgentDefinition {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  key                     String
  name                    String
  description             String?
  category                String   @default("general")
  status                  String   @default("active")
  defaultModelProvider    String   @default("openai")
  defaultModelName        String   @default("gpt-4o-mini")
  systemPrompt            String
  instructions            String?
  outputSchemaJson        Json?
  requiresApprovalDefault Boolean  @default(false)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  promptVersions          AgentPromptVersion[]
  runs                    AgentRun[]
  toolPermissions         AgentToolPermission[]

  @@unique([userId, key])
  @@index([userId, status])
  @@index([userId, category])
}

// IT: Prompt versions let you audit which prompt produced which run.
model AgentPromptVersion {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentDefinitionId   String
  agentDefinition     AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)

  version             Int
  systemPrompt        String
  instructions        String?
  outputSchemaJson    Json?
  isActive            Boolean  @default(false)
  createdBy           String   @default("system")
  createdAt           DateTime @default(now())

  runs                AgentRun[]

  @@unique([agentDefinitionId, version])
  @@index([userId, agentDefinitionId, isActive])
}

// IT: Tool definitions describe what an agent is allowed to do through Relish.
model AgentToolDefinition {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  key              String
  name             String
  description      String?
  toolType         String   @default("read")
  inputSchemaJson  Json?
  outputSchemaJson Json?
  requiresApproval Boolean  @default(false)
  isEnabled        Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  permissions      AgentToolPermission[]

  @@unique([userId, key])
  @@index([userId, toolType])
  @@index([userId, isEnabled])
}

// IT: Agent-to-tool permissions support read/propose/execute boundaries.
model AgentToolPermission {
  id                  String   @id @default(uuid())
  agentDefinitionId   String
  toolDefinitionId    String

  permissionLevel     String   @default("read")
  requiresApproval    Boolean  @default(false)
  constraintsJson     Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agentDefinition     AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  toolDefinition      AgentToolDefinition @relation(fields: [toolDefinitionId], references: [id], onDelete: Cascade)

  @@unique([agentDefinitionId, toolDefinitionId])
  @@index([toolDefinitionId])
}

// IT: One durable run for each agent execution.
model AgentRun {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentDefinitionId    String
  agentDefinition      AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)

  promptVersionId      String?
  promptVersion        AgentPromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  status               String   @default("queued")
  triggerType          String   @default("manual")
  triggerEntityType    String?
  triggerEntityId      String?

  inputJson            Json?
  resultJson           Json?
  errorMessage         String?

  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  steps                AgentStep[]
  toolCalls            AgentToolCall[]
  modelInvocations     ModelInvocation[]
  artifacts            AgentArtifact[]
  approvals            ApprovalRequest[]
  entities             AgentRunEntity[]
  researchCandidates   ResearchCandidate[]
  researchSources      ResearchSource[]
  opportunityScores    OpportunityScore[]
  contactEnrichments ContactEnrichment[]

  @@index([userId, status])
  @@index([userId, agentDefinitionId])
  @@index([triggerEntityType, triggerEntityId])
  @@index([createdAt])
}

// IT: Runs are broken into explicit steps so the UI can show what happened.
model AgentStep {
  id               String   @id @default(uuid())
  agentRunId       String
  run              AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  stepKey          String
  stepName         String
  status           String   @default("queued")
  inputJson        Json?
  outputJson       Json?
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  toolCalls        AgentToolCall[]
  modelInvocations ModelInvocation[]

  @@index([agentRunId, status])
  @@index([stepKey])
}

// IT: Every tool execution is logged, including tools that only read data.
model AgentToolCall {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId         String
  run               AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  agentStepId        String?
  step              AgentStep? @relation(fields: [agentStepId], references: [id], onDelete: SetNull)

  toolKey            String
  status             String   @default("running")
  inputJson          Json?
  outputJson         Json?
  errorMessage       String?

  createdEntityType  String?
  createdEntityId    String?

  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime @default(now())

  @@index([userId, toolKey])
  @@index([agentRunId])
  @@index([agentStepId])
}

// IT: Provider-independent model call log. Providers can change without changing agent tables.
model ModelInvocation {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId            String?
  run                  AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  agentStepId           String?
  step                 AgentStep? @relation(fields: [agentStepId], references: [id], onDelete: SetNull)

  provider             String
  model                String
  purpose              String?

  inputTokens          Int?
  outputTokens         Int?
  costEstimate         Decimal? @db.Decimal(12, 6)

  requestJsonRedacted  Json?
  responseJsonRedacted Json?
  structuredOutputJson Json?

  status               String   @default("success")
  errorMessage         String?
  createdAt            DateTime @default(now())

  @@index([userId, provider])
  @@index([agentRunId])
  @@index([agentStepId])
}

// IT: Artifacts are durable outputs generated by agents, such as broker briefings or research reports.
model AgentArtifact {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId      String?
  run            AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  agentStepId     String?
  artifactType   String
  title          String
  contentEnc     String?
  summaryEnc     String?
  structuredJson Json?

  entityType     String?
  entityId       String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, artifactType])
  @@index([userId, entityType, entityId])
  @@index([agentRunId])
}

// IT: Approval requests pause risky actions until a human approves or rejects them.
model ApprovalRequest {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId          String?
  run                AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  agentStepId         String?
  actionType          String
  entityType          String?
  entityId            String?

  proposedActionJson  Json?
  proposedDiffJson    Json?

  status              String   @default("pending")
  reviewerNote        String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  expiresAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, status])
  @@index([agentRunId])
  @@index([entityType, entityId])
}

// IT: Links a run to every Relish record it read, created, updated, or referenced.
model AgentRunEntity {
  id          String   @id @default(uuid())
  agentRunId  String
  run         AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  entityType  String
  entityId    String
  role        String   @default("referenced")
  createdAt   DateTime @default(now())

  @@index([agentRunId])
  @@index([entityType, entityId])
}


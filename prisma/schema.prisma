enum IntentConfidence {
  LOW
  MEDIUM
  HIGH
}

enum OfferDirection {
  SEEKING
  OFFERING
  OPEN_TO
  NOT_INTERESTED_IN
  OTHER
}

model Want {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)


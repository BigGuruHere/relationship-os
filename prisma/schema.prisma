  urgency    IntentUrgency @default(NORMAL)
  timeHorizon IntentTimeHorizon @default(ONGOING)
  confidence IntentConfidence @default(MEDIUM)

  // IT: Stage 8.2 provenance is a separate axis from confidence. Existing rows are deliberately marked legacy/unspecified.
  authority           KnowledgeAuthority  @default(LEGACY_UNSPECIFIED)
  sourceType          KnowledgeSourceType @default(MANUAL)
  sourceInteractionId String?
  sourceInteraction   Interaction? @relation("WantSourceInteraction", fields: [sourceInteractionId], references: [id], onDelete: SetNull)
  sourceNoteEnc       String?
  confirmedAt         DateTime?

  valueMinCents BigInt?
  valueMaxCents BigInt?
  currency      String @default("AUD")
  reviewAt      DateTime?
  expiresAt     DateTime?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // IT: Stage 8.4 canonical subject identity. userId still controls custody/access.
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)


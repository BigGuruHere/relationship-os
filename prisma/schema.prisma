  @@index([userId, dealId])
  @@index([userId, companyId])
  @@index([userId, relationshipType])
  @@index([userId, stage])
  @@index([userId, interestLevel])
  @@index([userId, nextFollowUpAt])
}

// IT: company graph for parents/subsidiaries, investors, referral partners, and related entities.
model CompanyRelationship {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyAId String
  companyBId String

  relationshipType CompanyRelationshipType?
  label            String? @default("related")
  notesEnc         String?
  isDirectional    Boolean @default(true)

  companyA Company @relation("CompanyAsA", fields: [companyAId], references: [id], onDelete: Cascade)
  companyB Company @relation("CompanyAsB", fields: [companyBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyAId, companyBId, relationshipType, label])
  @@index([userId, companyAId])
  @@index([userId, companyBId])
  @@index([userId, relationshipType])
}



// ---------------------------------------------------------------------------
// FIRST-CLASS WANT MODELS
// ---------------------------------------------------------------------------
// IT: Want is the demand-side object for buyer mandates, acquisition criteria,
// search briefs, and "keep an eye out" requests. Stage 7.3 also promoted Offers to a
// Stage 8.3 keeps Want and Offer as the canonical Core intent models; the legacy ExchangeItem model is retired.
// IT: Stage 8.2 separates where relationship intelligence came from from how confident we are in it.
// IT: WORKSPACE_RECORDED is for events/facts directly recorded by the current workspace rather than statements by the subject.
enum KnowledgeAuthority {
  LEGACY_UNSPECIFIED
  SELF_DECLARED
  THIRD_PARTY_REPORTED
  WORKSPACE_RECORDED
  PUBLIC_SOURCE
  INFERRED
  SYSTEM_DERIVED
}

enum KnowledgeSourceType {
  MANUAL
  INTERACTION
  PUBLIC_RESEARCH
  AGENT
  IMPORT
  SYSTEM
  OTHER
}


// ---------------------------------------------------------------------------
// STAGE 8.4 KNOWLEDGE + OBJECTIVE MODELS
// ---------------------------------------------------------------------------
enum KnowledgeClaimKind {
  FACT
  OBJECTIVE
  WANT
  OFFER
  PREFERENCE
  CONSTRAINT
  RELATIONSHIP_STATE
  OTHER
}

enum KnowledgeClaimStatus {
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum KnowledgeConfidence {
  LOW
  MEDIUM
  HIGH
}

// IT: Persistent higher-level outcome a person/company is trying to create.
// Operational tasks/deals remain Workspace concerns downstream of this object.
model Objective {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status IntentStatus @default(CAPTURED)
  titleEnc       String
  descriptionEnc String?
  importance     Int @default(3)
  confidence     IntentConfidence @default(MEDIUM)

  authority           KnowledgeAuthority  @default(THIRD_PARTY_REPORTED)
  sourceType          KnowledgeSourceType @default(MANUAL)
  sourceInteractionId String?
  sourceInteraction   Interaction? @relation("ObjectiveSourceInteraction", fields: [sourceInteractionId], references: [id], onDelete: SetNull)
  sourceNoteEnc       String?
  confirmedAt         DateTime?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  personId  String?
  person    Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  knowledgeClaims KnowledgeClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, contactId])
  @@index([userId, personId])
  @@index([userId, companyId])
  @@index([userId, sourceInteractionId])
  @@index([userId, updatedAt])
}

// IT: One canonical statement about a relationship subject. Evidence is append-only and
// can confirm the same claim from multiple interactions without duplicating the statement.
model KnowledgeClaim {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind       KnowledgeClaimKind
  status     KnowledgeClaimStatus @default(ACTIVE)
  statementEnc String
  statementIdx String
  authority  KnowledgeAuthority @default(WORKSPACE_RECORDED)
  confidence KnowledgeConfidence @default(MEDIUM)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  personId  String?
  person    Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  wantId      String?
  want        Want? @relation(fields: [wantId], references: [id], onDelete: SetNull)
  offerId     String?
  offer       Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  evidence KnowledgeEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind, status])
  @@index([userId, statementIdx])
  @@index([userId, contactId])
  @@index([userId, personId])
  @@index([userId, companyId])
  @@index([userId, objectiveId])
  @@index([userId, wantId])
  @@index([userId, offerId])
}

// IT: Source evidence for a KnowledgeClaim. Multiple interactions can support the same claim.
model KnowledgeEvidence {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  claimId String
  claim   KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  sourceInteractionId String?
  sourceInteraction   Interaction? @relation("KnowledgeEvidenceSourceInteraction", fields: [sourceInteractionId], references: [id], onDelete: SetNull)
  sourceType  KnowledgeSourceType @default(INTERACTION)
  authority   KnowledgeAuthority @default(WORKSPACE_RECORDED)
  confidence  KnowledgeConfidence @default(MEDIUM)
  // IT: Evidence can be invalidated independently from the claim it supports.
  // This lets one stale/incorrect source be retired without silently retiring current knowledge.
  status      KnowledgeClaimStatus @default(ACTIVE)
  noteEnc     String?
  observedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, claimId])
  @@index([userId, claimId, status])
  @@index([userId, sourceInteractionId])
  @@index([userId, sourceType])
  @@unique([claimId, sourceInteractionId])
}

enum WantType {
  GENERAL
  ACQUISITION_CRITERIA
  BUYER_MANDATE
  REFERRAL_REQUEST
  SERVICE_NEED
  ASSET_SEARCH
  FUNDING_NEED
  PARTNERSHIP_INTEREST
  TALENT_NEED
  OTHER
}

enum IntentStatus {
  CAPTURED

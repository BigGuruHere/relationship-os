// ---------------------------------------------------------------------------
// STAGE 8.2 INTRODUCTION + OUTCOME MODELS
// ---------------------------------------------------------------------------
// IT: Introduction records a real connection event. It is intentionally independent of PotentialMatch,
// which does not exist yet, so real introductions can teach the later matching design.
enum IntroductionStatus {
  PLANNED
  PROPOSED
  INTRODUCED
  CONNECTED
  DECLINED
  CLOSED
}

enum IntroductionSide {
  A
  B
}

enum OutcomeStatus {
  UNKNOWN
  NO_RESPONSE
  DECLINED
  CONNECTED
  CONTINUING
  SUCCESSFUL
  ENDED
}

enum OutcomeCommerciality {
  UNKNOWN
  NON_COMMERCIAL
  COMMERCIAL
}

model Introduction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     IntroductionStatus @default(INTRODUCED)
  occurredAt DateTime           @default(now())

  reasonEnc   String?
  notesEnc    String?
  evidenceEnc String?

  // IT: provenance of the introduction record itself. Authority remains distinct from source and confidence.
  authority           KnowledgeAuthority  @default(WORKSPACE_RECORDED)
  sourceType          KnowledgeSourceType @default(MANUAL)
  sourceInteractionId String?
  sourceInteraction   Interaction? @relation("IntroductionSourceInteraction", fields: [sourceInteractionId], references: [id], onDelete: SetNull)

  // IT: Optional linked facilitator when somebody other than the workspace owner made the introduction.
  facilitatorContactId String?
  facilitatorContact   Contact? @relation("IntroductionFacilitator", fields: [facilitatorContactId], references: [id], onDelete: SetNull)

  participants IntroductionParticipant[]
  outcomes     Outcome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, occurredAt])
  @@index([userId, authority])
  @@index([userId, sourceType])
  @@index([userId, sourceInteractionId])
  @@index([userId, facilitatorContactId])
}

// IT: Exactly two sides are used in Stage 8.2. A side can be a Contact, Company, or both
// (for example, a named person representing a company). Tenant ownership is duplicated here deliberately
// so every participant query can fail closed without traversing the parent first.
model IntroductionParticipant {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  introductionId String
  introduction   Introduction @relation(fields: [introductionId], references: [id], onDelete: Cascade)

  side IntroductionSide

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  roleEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([introductionId, side])
  @@index([userId, contactId])
  @@index([userId, companyId])
}

// IT: Outcomes are appendable observations over time rather than one mutable final field.
// This lets early "spoke" or "continuing" evidence coexist with a later commercial or non-commercial result.
model Outcome {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  introductionId String
  introduction   Introduction @relation(fields: [introductionId], references: [id], onDelete: Cascade)

  status        OutcomeStatus        @default(UNKNOWN)
  commerciality OutcomeCommerciality @default(UNKNOWN)
  useful        Boolean?
  continued     Boolean?

  valueCents BigInt?
  currency   String @default("AUD")

  resultEnc   String?
  notesEnc    String?
  evidenceEnc String?

  authority           KnowledgeAuthority  @default(WORKSPACE_RECORDED)
  sourceType          KnowledgeSourceType @default(MANUAL)
  sourceInteractionId String?
  sourceInteraction   Interaction? @relation("OutcomeSourceInteraction", fields: [sourceInteractionId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, introductionId, occurredAt])
  @@index([userId, status])
  @@index([userId, commerciality])
  @@index([userId, authority])
  @@index([userId, sourceType])
  @@index([userId, sourceInteractionId])
}

// ---------------------------------------------------------------------------
// STAGE 6 MARKET LEADS
// ---------------------------------------------------------------------------
// IT: Channel preference for contacts and leads. This is workflow metadata used
// to choose the right relationship action.
enum CommunicationMethod {
  LINKEDIN
  EMAIL
  PHONE
  SMS
  WHATSAPP
  IN_PERSON
  OTHER
  UNKNOWN
}

// IT: Broad lead types for market-making. These are deliberately broader than
// Contact/Company/Deal so you can capture uncertain items before they are researched.
enum MarketLeadType {
  BUYER
  SELLER
  COMPANY
  CONTACT
  MANDATE
  ASSET
  REFERRER
  OTHER
  POTENTIAL_BUYER
  POTENTIAL_SELLER
}

// IT: Review lifecycle for market leads.
enum MarketLeadStatus {
  NEW
  RESEARCHING
  QUALIFIED
  CONVERTED
  NOT_RELEVANT
  ARCHIVED
  NOT_CONTACTED
  TRIED_NO_CONTACT
  LEFT_VOICEMAIL
  FOLLOW_UP_NEEDED
  CONTACTED
  RESPONDED
  NURTURE
}

// IT: Where this lead came from. Keep it high-level for filtering.
enum MarketLeadSource {
  MANUAL
  OUTREACH
  REFERRAL
  INBOUND
  RESEARCH
  IMPORTED
  AI
  OTHER
}


// IT: Custom user-owned lead sources. This lets you reuse sources like Sam,
// Sam spreadsheet, MFAA list, LinkedIn, or referral partner names in dropdowns.
model LeadSource {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nameEnc String
  nameIdx String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketLeads MarketLead[]
  contacts    Contact[]

  @@unique([userId, nameIdx])
  @@index([userId, updatedAt])
  @@index([nameIdx])
}

// IT: A market-making lead: an unconfirmed person, company, mandate, asset,
// referrer, buyer, or seller signal that may later become CRM truth.
model MarketLead {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   MarketLeadType   @default(OTHER)
  status MarketLeadStatus @default(NEW)
  source MarketLeadSource @default(MANUAL)

  leadSourceId String?
  leadSource   LeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)

  titleEnc       String
  titleIdx       String
  nameEnc        String?
  nameIdx        String?
  companyNameEnc String?
  companyNameIdx String?
  emailEnc       String?
  emailIdx       String?
  phoneEnc       String?
  phoneIdx       String?
  websiteEnc     String?
  websiteIdx     String?
  linkedinEnc    String?
  linkedinIdx    String?
  roleTitleEnc   String?
  geographyEnc   String?
  addressEnc     String?
  addressIdx     String?
  descriptionEnc String?
  notesEnc       String?
  sourceUrlEnc   String?

  usualCommunicationMethod CommunicationMethod?

  // IT: Stage 6.6 outreach/qualification fields. Kept as text to avoid enum migration friction.
  contactAttemptStatus String @default("NOT_CONTACTED")
  lastContactedAt      DateTime?
  buyerStatus          String @default("NOT_ASKED")
  sellerStatus         String @default("NOT_ASKED")

  confidence Int @default(50)
  priority   Int @default(3)
  valueMinCents BigInt?
  valueMaxCents BigInt?
  currency      String @default("AUD")
  nextActionEnc String?
  nextActionAt  DateTime?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  workstreamId String?
  workstream   ProjectWorkstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)

  tasks Task[]
  notes MarketLeadNote[]

  wantId String?
  want   Want? @relation(fields: [wantId], references: [id], onDelete: SetNull)

  offerId String?
  offer   Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  convertedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, type])
  @@index([userId, status])
  @@index([userId, source])
  @@index([userId, leadSourceId])
  @@index([userId, priority])
  @@index([userId, confidence])
  @@index([userId, usualCommunicationMethod])
  @@index([userId, contactAttemptStatus])
  @@index([userId, buyerStatus])
  @@index([userId, sellerStatus])
  @@index([userId, lastContactedAt])
  @@index([userId, contactId])
  @@index([userId, companyId])
  @@index([userId, dealId])
  @@index([userId, projectId])
  @@index([userId, workstreamId])
  @@index([userId, wantId])
  @@index([userId, offerId])
  @@index([titleIdx])
  @@index([nameIdx])
  @@index([companyNameIdx])
  @@index([emailIdx])
  @@index([phoneIdx])
  @@index([websiteIdx])
  @@index([linkedinIdx])
  @@index([addressIdx])
}

// IT: time-stamped notes attached directly to a market lead. These preserve early, messy
// research and conversation context before the lead is converted into stronger CRM records.
model MarketLeadNote {
  id String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketLeadId String
  marketLead   MarketLead @relation(fields: [marketLeadId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())
  channel    String   @default("note")
  bodyEnc    String
  summaryEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, marketLeadId, occurredAt])
  @@index([userId, marketLeadId, createdAt])
}

// ---------------------------------------------------------------------------
// PROJECT AND TASK MODELS
// ---------------------------------------------------------------------------
enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

// IT: Workstreams organise a project into lanes such as Buyer mandates, Seller outreach, Referrers, and Active deals.
enum ProjectWorkstreamStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  SNOOZED
  DONE
  CANCELLED
}

enum TaskUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TaskImportance {
  LOW
  NORMAL
  HIGH
}

enum TaskFocus {
  NEW
  DOING_NOW
  NOT_DOING_NOW
  NEVER_DOING_NOW
}

enum TaskRecurrenceRule {
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum TaskType {
  FOLLOW_UP
  CALL
  EMAIL
  SEND_DOCUMENT
  BOOK_MEETING
  RESEARCH
  PREPARE
  REVIEW
  INTRODUCE
  DECISION
  ADMIN
  PERSONAL_TODO
  DEAL_STEP
  CUSTOM
}

// IT: a broader work container that can hold tasks and be linked manually by name/context.
model Project {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titleEnc       String
  titleIdx       String
  descriptionEnc String?
  status         ProjectStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
  notes ProjectNote[]
  deals ProjectDeal[]
  wants         Want[]
  offers        Offer[]
  marketLeads   MarketLead[]
  workstreams   ProjectWorkstream[]

  @@index([userId, status])
  @@index([titleIdx])
}


// IT: A lane within a project. Workstreams let one market/campaign contain buyer mandates, seller outreach, referrers, research, and active deals without creating separate projects.
model ProjectWorkstream {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  nameEnc        String
  nameIdx        String
  descriptionEnc String?
  status         ProjectWorkstreamStatus @default(ACTIVE)
  sortOrder      Int @default(0)

  marketLeads  MarketLead[]
  wants        Want[]
  offers       Offer[]
  tasks        Task[]
  projectDeals ProjectDeal[]
  projectNotes ProjectNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, nameIdx])
  @@index([userId, projectId, status])
  @@index([userId, status])
  @@index([nameIdx])
}

// IT: Direct many-to-many link between projects and deals.
// IT: A task can still relate to both, but this table says the deal belongs to the project.
model ProjectDeal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workstreamId String?
  workstream   ProjectWorkstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)

  dealId String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  labelEnc String?
  notesEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, dealId])
  @@index([userId, projectId])
  @@index([userId, workstreamId])
  @@index([userId, dealId])
  @@index([userId, createdAt])
}

// IT: time-stamped notes attached directly to a project. These are separate from the project description.
model ProjectNote {
  id String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workstreamId String?
  workstream   ProjectWorkstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  channel    String   @default("note")
  bodyEnc    String
  summaryEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, projectId, createdAt])
  @@index([userId, workstreamId, createdAt])
}

// IT: unified action system. A task can link to a person, deal, deal-contact thread, or project.
model Task {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titleEnc   String
  notesEnc   String?
  summaryEnc String?

  status     TaskStatus     @default(OPEN)
  urgency    TaskUrgency    @default(NORMAL)
  importance TaskImportance @default(NORMAL)
  focus      TaskFocus      @default(NEW)
  taskType   TaskType       @default(FOLLOW_UP)

  dueAt        DateTime?
  snoozedUntil DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  recurrenceRule     TaskRecurrenceRule?
  recurrenceSeriesId String?
  recurrenceAnchorAt DateTime?

  // IT: assignment is intentionally flexible while the app is still single-user.
  assignedToTextEnc  String?
  assignedToContactId String?
  assignedToContact   Contact? @relation("TaskAssignedContact", fields: [assignedToContactId], references: [id], onDelete: SetNull)

  waitingOnContactId String?
  waitingOnContact   Contact? @relation("TaskWaitingContact", fields: [waitingOnContactId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation("TaskContact", fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  dealContactId String?
  dealContact   DealContact? @relation(fields: [dealContactId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  workstreamId String?
  workstream   ProjectWorkstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)

  marketLeadId String?
  marketLead   MarketLead? @relation(fields: [marketLeadId], references: [id], onDelete: SetNull)

  wantId String?
  want   Want? @relation(fields: [wantId], references: [id], onDelete: SetNull)

  offerId String?
  offer   Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  // IT: optional company context for broker work.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  companyContactId String?
  companyContact   CompanyContact? @relation(fields: [companyContactId], references: [id], onDelete: SetNull)

  dealCompanyId String?
  dealCompany   DealCompany? @relation(fields: [dealCompanyId], references: [id], onDelete: SetNull)

  sourceType String?
  sourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, dueAt])
  @@index([userId, focus, dueAt])
  @@index([userId, urgency])
  @@index([userId, contactId])
  @@index([userId, dealId])
  @@index([userId, dealContactId])
  @@index([userId, projectId])
  @@index([userId, workstreamId])
  @@index([userId, marketLeadId])
  @@index([userId, wantId])
  @@index([userId, offerId])
  @@index([userId, companyId])
  @@index([userId, companyContactId])
  @@index([userId, dealCompanyId])
  @@index([userId, waitingOnContactId])
  @@index([userId, recurrenceSeriesId, status])
}


// ---------------------------------------------------------------------------
// AGENT STAGE 2 OUTREACH MODELS
// ---------------------------------------------------------------------------
// IT: Candidate type staged by the Outreach Agent before importing into CRM.
enum ResearchCandidateEntityType {
  COMPANY
  CONTACT
}

// IT: Review/import lifecycle for AI-found or manually pasted research candidates.
enum ResearchCandidateStatus {
  CANDIDATE
  APPROVED
  REJECTED
  IMPORTED
}


// IT: Stage 3 source types captured by controlled live research tools.
enum ResearchSourceType {
  SEARCH_RESULT
  WEB_PAGE
  USER_SOURCE
  EXTRACTED_PROFILE
  OTHER
}

// IT: Temporary staging area. AI can propose candidates here without polluting real CRM data.
model ResearchCandidate {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId String?
  run        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  entityType ResearchCandidateEntityType @default(COMPANY)
  status     ResearchCandidateStatus     @default(CANDIDATE)

  nameEnc       String
  nameIdx       String
  websiteEnc    String?
  websiteIdx    String?
  sourceUrlEnc  String?
  sourceLabelEnc String?
  confidence    Int @default(50)

  structuredJson Json?
  notesEnc       String?

  createdEntityType String?
  createdEntityId   String?

  opportunityScores OpportunityScore[]
  opportunityScoreFactors OpportunityScoreFactor[]
  researchSources    ResearchSource[]
  contactEnrichments ContactEnrichment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, entityType])
  @@index([userId, nameIdx])
  @@index([agentRunId])
}


// IT: Durable evidence/source log for live research.
// IT: Agents can read web/search output, but Relish stores the source and only stages proposed CRM changes.
model ResearchSource {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId String?
  run        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  researchCandidateId String?
  researchCandidate   ResearchCandidate? @relation(fields: [researchCandidateId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  sourceType ResearchSourceType @default(SEARCH_RESULT)
  provider   String @default("manual")
  confidence Int    @default(50)

  queryEnc   String?
  titleEnc   String?
  urlEnc     String?
  snippetEnc String?
  contentEnc String?

  evidenceJson Json?
  fetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sourceType])
  @@index([userId, provider])
  @@index([userId, companyId])
  @@index([userId, contactId])
  @@index([userId, researchCandidateId])
  @@index([agentRunId])
}


// IT: Stage 5 Contact Enrichment staging. Proposed contact details are not CRM truth until reviewed/applied.
model ContactEnrichment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId String?
  run        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  researchCandidateId String?
  researchCandidate   ResearchCandidate? @relation(fields: [researchCandidateId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  status     String @default("CANDIDATE")
  confidence Int    @default(50)

  // IT: Stage 5.1 stores enrichment at field level so email, phone, LinkedIn, role, and company data can be reviewed independently.
  groupKey       String?
  fieldKey       String?
  fieldLabel     String?
  proposedValueEnc String?
  existingValueEnc String?
  evidenceType   String @default("UNKNOWN")
  sourceKind     String?
  conflictStatus String @default("NEW")
  isApplyable    Boolean @default(true)

  targetNameEnc String?
  fullNameEnc   String?
  emailEnc      String?
  phoneEnc      String?
  linkedinEnc   String?
  companyNameEnc String?
  roleTitleEnc    String?
  websiteEnc      String?

  sourceUrlEnc   String?
  sourceLabelEnc String?
  evidenceEnc    String?
  notesEnc       String?
  structuredJson Json?

  appliedAt DateTime?
  appliedEntityType String?
  appliedEntityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, contactId])
  @@index([userId, companyId])
  @@index([userId, researchCandidateId])
  @@index([agentRunId])
  @@index([userId, fieldKey])
  @@index([agentRunId, groupKey])
  @@index([userId, conflictStatus])
}

// IT: Structured opportunity scoring for a staged candidate or existing CRM record.
model OpportunityScore {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId String?
  run        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  researchCandidateId String?
  researchCandidate   ResearchCandidate? @relation(fields: [researchCandidateId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // IT: Stage 4 scorecards are still advisory. They rank attention, not truth.
  scoreVersion        Int    @default(2)
  scoreLabel          String @default("watch")
  priority            String @default("medium")
  recommendedAction   String?

  totalScore          Int @default(0)
  sectorFitScore      Int?
  ownerLedScore       Int?
  dealLikelihoodScore Int?
  outreachFitScore    Int?
  timingScore         Int?
  confidenceScore     Int?

  strategicFitScore      Int?
  valuePotentialScore    Int?
  relationshipPathScore  Int?
  evidenceQualityScore   Int?
  riskScore              Int?

  rationaleJson       Json?
  factors             OpportunityScoreFactor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, totalScore])
  @@index([userId, scoreLabel])
  @@index([userId, priority])
  @@index([userId, companyId])
  @@index([userId, contactId])
  @@index([userId, dealId])
  @@index([userId, researchCandidateId])
  @@index([agentRunId])
}

// IT: Stage 4 score-factor table. Each score is explainable and reviewable.
model OpportunityScoreFactor {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  opportunityScoreId String
  opportunityScore   OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)

  researchCandidateId String?
  researchCandidate   ResearchCandidate? @relation(fields: [researchCandidateId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  criterionKey   String
  criterionLabel String
  score          Int @default(0)
  weight         Int @default(1)
  polarity       String @default("positive")
  confidence     Int @default(50)

  evidenceEnc    String?
  rationaleEnc   String?
  sourceUrlEnc   String?
  metadataJson   Json?

  createdAt DateTime @default(now())

  @@index([userId, criterionKey])
  @@index([userId, opportunityScoreId])
  @@index([userId, researchCandidateId])
  @@index([userId, companyId])
  @@index([userId, contactId])
  @@index([userId, dealId])
}

// ---------------------------------------------------------------------------
// AGENT FRAMEWORK MODELS
// ---------------------------------------------------------------------------
// IT: AgentDefinition is the durable configuration for a specialised agent.
// IT: Relish remains the source of truth - agents act through registered tools and logged runs.
model AgentDefinition {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  key                     String
  name                    String
  description             String?
  category                String   @default("general")
  status                  String   @default("active")
  defaultModelProvider    String   @default("openai")
  defaultModelName        String   @default("gpt-4o-mini")
  systemPrompt            String
  instructions            String?
  outputSchemaJson        Json?
  requiresApprovalDefault Boolean  @default(false)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  promptVersions          AgentPromptVersion[]
  runs                    AgentRun[]
  toolPermissions         AgentToolPermission[]

  @@unique([userId, key])
  @@index([userId, status])
  @@index([userId, category])
}

// IT: Prompt versions let you audit which prompt produced which run.
model AgentPromptVersion {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentDefinitionId   String
  agentDefinition     AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)

  version             Int
  systemPrompt        String
  instructions        String?
  outputSchemaJson    Json?
  isActive            Boolean  @default(false)
  createdBy           String   @default("system")
  createdAt           DateTime @default(now())

  runs                AgentRun[]

  @@unique([agentDefinitionId, version])
  @@index([userId, agentDefinitionId, isActive])
}

// IT: Tool definitions describe what an agent is allowed to do through Relish.
model AgentToolDefinition {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  key              String
  name             String
  description      String?
  toolType         String   @default("read")
  inputSchemaJson  Json?
  outputSchemaJson Json?
  requiresApproval Boolean  @default(false)
  isEnabled        Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  permissions      AgentToolPermission[]

  @@unique([userId, key])
  @@index([userId, toolType])
  @@index([userId, isEnabled])
}

// IT: Agent-to-tool permissions support read/propose/execute boundaries.
model AgentToolPermission {
  id                  String   @id @default(uuid())
  agentDefinitionId   String
  toolDefinitionId    String

  permissionLevel     String   @default("read")
  requiresApproval    Boolean  @default(false)
  constraintsJson     Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agentDefinition     AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  toolDefinition      AgentToolDefinition @relation(fields: [toolDefinitionId], references: [id], onDelete: Cascade)

  @@unique([agentDefinitionId, toolDefinitionId])
  @@index([toolDefinitionId])
}

// IT: One durable run for each agent execution.
model AgentRun {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentDefinitionId    String
  agentDefinition      AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)

  promptVersionId      String?
  promptVersion        AgentPromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  status               String   @default("queued")
  triggerType          String   @default("manual")
  triggerEntityType    String?
  triggerEntityId      String?

  inputJson            Json?
  resultJson           Json?
  errorMessage         String?

  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  steps                AgentStep[]
  toolCalls            AgentToolCall[]
  modelInvocations     ModelInvocation[]
  artifacts            AgentArtifact[]
  approvals            ApprovalRequest[]
  entities             AgentRunEntity[]
  researchCandidates   ResearchCandidate[]
  researchSources      ResearchSource[]
  opportunityScores    OpportunityScore[]
  contactEnrichments ContactEnrichment[]

  @@index([userId, status])
  @@index([userId, agentDefinitionId])
  @@index([triggerEntityType, triggerEntityId])
  @@index([createdAt])
}

// IT: Runs are broken into explicit steps so the UI can show what happened.
model AgentStep {
  id               String   @id @default(uuid())
  agentRunId       String
  run              AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  stepKey          String
  stepName         String
  status           String   @default("queued")
  inputJson        Json?
  outputJson       Json?
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  toolCalls        AgentToolCall[]
  modelInvocations ModelInvocation[]

  @@index([agentRunId, status])
  @@index([stepKey])
}

// IT: Every tool execution is logged, including tools that only read data.
model AgentToolCall {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId         String
  run               AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  agentStepId        String?
  step              AgentStep? @relation(fields: [agentStepId], references: [id], onDelete: SetNull)

  toolKey            String
  status             String   @default("running")
  inputJson          Json?
  outputJson         Json?
  errorMessage       String?

  createdEntityType  String?
  createdEntityId    String?

  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime @default(now())

  @@index([userId, toolKey])
  @@index([agentRunId])
  @@index([agentStepId])
}

// IT: Provider-independent model call log. Providers can change without changing agent tables.
model ModelInvocation {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId            String?
  run                  AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  agentStepId           String?
  step                 AgentStep? @relation(fields: [agentStepId], references: [id], onDelete: SetNull)

  provider             String
  model                String
  purpose              String?

  inputTokens          Int?
  outputTokens         Int?
  costEstimate         Decimal? @db.Decimal(12, 6)

  requestJsonRedacted  Json?
  responseJsonRedacted Json?
  structuredOutputJson Json?

  status               String   @default("success")
  errorMessage         String?
  createdAt            DateTime @default(now())

  @@index([userId, provider])
  @@index([agentRunId])
  @@index([agentStepId])
}

// IT: Artifacts are durable outputs generated by agents, such as broker briefings or research reports.
model AgentArtifact {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId      String?
  run            AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  agentStepId     String?
  artifactType   String
  title          String
  contentEnc     String?
  summaryEnc     String?
  structuredJson Json?

  entityType     String?
  entityId       String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, artifactType])
  @@index([userId, entityType, entityId])
  @@index([agentRunId])
}

// IT: Approval requests pause risky actions until a human approves or rejects them.
model ApprovalRequest {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId          String?
  run                AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  agentStepId         String?
  actionType          String
  entityType          String?
  entityId            String?

  proposedActionJson  Json?
  proposedDiffJson    Json?

  status              String   @default("pending")
  reviewerNote        String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  expiresAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, status])
  @@index([agentRunId])
  @@index([entityType, entityId])
}

// IT: Links a run to every Relish record it read, created, updated, or referenced.
model AgentRunEntity {
  id          String   @id @default(uuid())
  agentRunId  String
  run         AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  entityType  String
  entityId    String
  role        String   @default("referenced")
  createdAt   DateTime @default(now())

  @@index([agentRunId])
  @@index([entityType, entityId])
}


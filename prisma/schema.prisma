  companyContactId String?
  companyContact   CompanyContact? @relation(fields: [companyContactId], references: [id], onDelete: SetNull)

  convertedDealId String?

  embeddingVec Unsupported("vector")? @map("embedding_vec")

  tasks Task[]
  notes WantNote[]
  marketLeads MarketLead[]
  knowledgeClaims KnowledgeClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, wantType])
  @@index([userId, status])
  @@index([userId, urgency])
  @@index([userId, timeHorizon])
  @@index([userId, confidence])
  @@index([userId, authority])
  @@index([userId, sourceType])
  @@index([userId, sourceInteractionId])
  @@index([userId, contactId])
  @@index([userId, personId])
  @@index([userId, companyId])
  @@index([userId, dealId])
  @@index([userId, projectId])
  @@index([userId, workstreamId])
  @@index([userId, companyContactId])
  @@index([userId, reviewAt])
  @@index([userId, expiresAt])
  @@index([userId, createdAt])
}

model WantNote {
  id String @id @default(uuid())
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  wantId String
  want   Want @relation(fields: [wantId], references: [id], onDelete: Cascade)

